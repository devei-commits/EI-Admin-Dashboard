# Backend API base URL (origin only, no trailing slash).
# In development, leave unset to use the Vite proxy (relative /api → localhost:3000).
# In production (e.g. Vercel), set this to your backend origin so login and all API
# requests go to the remote server instead of the frontend host.
# Example: https://your-backend.herokuapp.com or https://api.yourcompany.com
VITE_API_BASE_URL=
